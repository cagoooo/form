rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'admin@form.system');
    }

    // Users collection:
    // - 本人可讀自己的資料；管理員可讀全部（使用者管理）
    // - 本人只能在「第一次登入」建立自己的資料，身分只能是 editor（共用管理員帳號 admin@form.system 才能是 admin），
    //   email 必須是自己的、欄位只能有 email／role／createdAt
    // - 改身分（升降級）與刪除：只有管理員
    // 2026-11-18 修正：舊規則允許本人寫自己的整份文件（含 role），任何 Google 帳號都能把自己改成 admin。
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.role == 'editor'
            || (request.resource.data.role == 'admin' && request.auth.token.email == 'admin@form.system'))
      );
      allow update, delete: if isAdmin();
    }

    // Templates: 
    // - Public read (for rendering forms)
    // - Authenticated users (Editors & Admins) can create/update
    // - Only Admins (or owners, but simplified to Admins/Editors for now) can delete? 
    //   Let's allow all authenticated users to manage templates fully as requested.
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Submissions: 
    // - Public create
    // - Authenticated users (Editors & Admins) can read/write
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}
