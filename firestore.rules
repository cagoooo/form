rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'admin@form.system');
    }

    // Users collection: 
    // - Users can read/write their own profile
    // - Admins can read all profiles (for User Management)
    // - Admins can write all profiles (to promote/demote users)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Templates: 
    // - Public read (for rendering forms)
    // - Authenticated users (Editors & Admins) can create/update
    // - Only Admins (or owners, but simplified to Admins/Editors for now) can delete? 
    //   Let's allow all authenticated users to manage templates fully as requested.
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Submissions: 
    // - Public create
    // - Authenticated users (Editors & Admins) can read/write
    match /submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}
